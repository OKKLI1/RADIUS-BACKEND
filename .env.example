# Copia este archivo como .env y ajusta los valores
DB_HOST=localhost
DB_PORT=3306
DB_USER=radius
DB_PASSWORD=change-this-password
DB_NAME=radius

# Seguridad JWT - cambia esto por una clave aleatoria larga
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# GUI Admin - credenciales para el login del panel web
GUI_ADMIN_USER=admin
GUI_ADMIN_PASSWORD=change-this-admin-password
